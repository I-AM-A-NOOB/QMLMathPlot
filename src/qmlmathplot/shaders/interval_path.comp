#version 440
layout(local_size_x = 1) in;
@INCLUDE:common/uniforms.glsl@
layout(std430, binding = 1) buffer V {
    float verts[];
};
@INCLUDE:common/arg_reduction.glsl@
@INCLUDE:common/real_pow.glsl@
@INTERVAL_LIB@
@INTERVALS@

float sy(float y) { return (camera.y - y) / camera.w + 0.5 * size.y; }
float syc(float y) { return sy(clamp(y, -1e12, 1e12)); }
float sx(int col) { return float(col); }
float ytop() { return camera.y + 0.5 * size.y * camera.w; }
float ybot() { return camera.y - 0.5 * size.y * camera.w; }
float smx(int col) { return float(col) + 0.5; }
vec2 ndc(vec2 p) {
    return vec2(p.x / size.x * 2.0 - 1.0, 1.0 - p.y / size.y * 2.0);
}
void put(int col, int quad, int corner, vec2 p, vec4 c, vec2 local) {
    int base = ((col * 3 + quad) * 6 + corner) * 8;
    vec2 n = ndc(p);
    verts[base + 0] = n.x;
    verts[base + 1] = n.y;
    verts[base + 2] = c.r * c.a;
    verts[base + 3] = c.g * c.a;
    verts[base + 4] = c.b * c.a;
    verts[base + 5] = c.a;
    verts[base + 6] = local.x;
    verts[base + 7] = local.y;
}
void slot(int col, int q, vec2 a, vec2 b) {
    vec2 d = b - a;
    float len = length(d);
    vec2 nrm = len > 1e-6 ? vec2(-d.y, d.x) / len * lineWidth * 0.5 : vec2(0.0);
    vec4 c = color;
    put(col, q, 0, a + nrm, c, vec2(0.0));
    put(col, q, 1, a - nrm, c, vec2(0.0));
    put(col, q, 2, b - nrm, c, vec2(0.0));
    put(col, q, 3, a + nrm, c, vec2(0.0));
    put(col, q, 4, b - nrm, c, vec2(0.0));
    put(col, q, 5, b + nrm, c, vec2(0.0));
}
// A round join: a screen-aligned quad clipped to a disc by path.frag. Segment quads alone
// leave a square where two 1-px chords meet at a sharp bend.
void join(int col, vec2 p) {
    float h = lineWidth * 0.5;
    vec4 c = color;
    put(col, 2, 0, p + vec2(-h, -h), c, vec2(-1.0, -1.0));
    put(col, 2, 1, p + vec2( h, -h), c, vec2( 1.0, -1.0));
    put(col, 2, 2, p + vec2( h,  h), c, vec2( 1.0,  1.0));
    put(col, 2, 3, p + vec2(-h, -h), c, vec2(-1.0, -1.0));
    put(col, 2, 4, p + vec2( h,  h), c, vec2( 1.0,  1.0));
    put(col, 2, 5, p + vec2(-h,  h), c, vec2(-1.0,  1.0));
}

// The path state machine is shared with the GPU trace harness.
@INCLUDE:path_state.glsl@

void main() {
    int cols = int(max(1.0, size.x) * float(@SUBSAMPLES@));
    float dx = camera.z / float(@SUBSAMPLES@);
    float xmin = camera.x - 0.5 * size.x * camera.z;
    g_left = i_empty();
    g_next = FI(xmin, xmin + dx);
    g_last = i_empty();
    g_has_last = false;
    g_has_point = false;
    g_point = vec2(0.0);
    for (int col = 0; col < cols; col++) {
        IVal cur = g_next;
        float x0 = xmin + float(col) * dx;
        float x1 = x0 + dx;
        if (col + 1 < cols) {
            float nx = xmin + float(col + 1) * dx;
            g_next = FI(nx, nx + dx);
        } else {
            g_next = i_empty();
        }
        // Start each column as two degenerate quads; the topology fills one or both.
        for (int qq = 0; qq < 3; qq++) {
            for (int k = 0; k < 6; k++) {
                put(col, qq, k, vec2(10.0), vec4(0.0), vec2(0.0));
            }
        }
        if (cur.kind == IK_EMPTY) {
            g_has_last = false;
            g_has_point = false;
            g_left = cur;
            continue;
        }
        g_seg_n = 0;
        draw_column(col, x0, x1, cur);
        for (int k = 0; k < 2; k++) {
            if (k < g_seg_n) {
                slot(col, k, g_seg_a[k], g_seg_b[k]);
            }
        }
        if (g_seg_n > 0) {
            join(col, g_seg_a[g_seg_n - 1]);
        }
        g_left = cur;
    }
}
